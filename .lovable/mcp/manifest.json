{
  "version": 1,
  "sdk_version": "3.5.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://yayosibohzruoplhownd.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "code-continuity-hub",
      "version": "0.1.0",
      "title": "Code Continuity Hub"
    },
    "tools": [
      {
        "name": "list_cases",
        "title": "List FIR cases",
        "description": "List the signed-in officer's FIR cases and reconstruction status, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "status": {
              "description": "Only return cases in this processing state.",
              "type": "string",
              "enum": [
                "pending",
                "preprocessing",
                "entity_extraction",
                "spatial_resolution",
                "timeline_sequencing",
                "scene_generation",
                "completed",
                "failed"
              ]
            },
            "limit": {
              "default": 20,
              "description": "Maximum number of cases to return, from 1 to 50.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_case",
        "title": "Get FIR case details",
        "description": "Read one permitted FIR case, including its narrative, location, and processing status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The job ID returned by list_cases."
            }
          },
          "required": [
            "job_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_reconstruction",
        "title": "Get reconstruction timeline",
        "description": "Read the extracted people, vehicles, objects, and chronological actions for one permitted case.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The job ID returned by list_cases."
            }
          },
          "required": [
            "job_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
